---
import { getCollection } from 'astro:content';


const products = await getCollection('products');
const prices = await getCollection('prices');
const plans = await getCollection('plans');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
        <h1>Stripe Astro Data Loader</h1>
        <p>Fetch and cache from Stripe using Astro's Content Layer</p>
	    <h3>Products</h3>
        <ul>
            {products.map((product) => (
                <li><a href={`/products/${product.id}`}>{product.data.name}</a></li>
            ))}
        </ul>

        <h3>Prices</h3>
        <ul>
            {prices.map((price) => (
                <li><a href={`/prices/${price.id}`}>{price.data.nickname || price.id} - {price.data.currency.toUpperCase()} {price.data.unit_amount ? (price.data.unit_amount / 100).toFixed(2) : 'Custom'}</a></li>
            ))}
        </ul>

        <h3>Plans</h3>
        <ul>
            {plans.map((plan) => (
                <li><a href={`/plans/${plan.id}`}>{plan.data.nickname || plan.id} - {plan.data.currency.toUpperCase()} {plan.data.amount ? (plan.data.amount / 100).toFixed(2) : 'Free'}</a></li>
            ))}
        </ul>
	</body>
</html>
